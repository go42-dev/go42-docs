---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { formatDate, getBlogPosts } from '../../lib/blog';
const posts = await getBlogPosts(import.meta.env.DEV);
---

<SiteLayout title="Notes from the build" description="Ideas, experiments, and lessons from developing Go42.">
  <section class="page-heading container">
    <p class="eyebrow">THE GO42 BLOG</p>
    <h1>Notes from the build.</h1>
    <p>Ideas, experiments, and the thinking behind Go42.</p>
    <a class="text-link" href="/rss.xml">Subscribe with RSS <span aria-hidden="true">↗</span></a>
  </section>
  <section class="blog-list container" aria-label="Blog posts">
    {posts.length > 0 ? posts.map((post) => (
      <article class="post-card">
        <div class="post-meta">
          {post.data.draft ? <span class="draft-badge">Draft preview</span> : <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>}
          {post.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
        <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
        <a class="text-link" href={`/blog/${post.id}/`}>Read the article <span aria-hidden="true">↗</span></a>
      </article>
    )) : (
      <div class="empty-blog">
        <span class="empty-symbol" aria-hidden="true">✳</span>
        <h2>The first page is still being written.</h2>
        <p>In the meantime, the guide is a good place to get to know Go42.</p>
        <a class="button button-primary" href="/docs/">Explore the documentation <span aria-hidden="true">↗</span></a>
      </div>
    )}
  </section>
</SiteLayout>
