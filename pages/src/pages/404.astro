---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found" description="Find your way back to the Go42 website." noindex>
  <section class="not-found container">
    <p class="eyebrow">404 / PAGE NOT FOUND</p>
    <h1>A small detour.</h1>
    <p>This page isn't here. The documentation can help you find your next step.</p>
    <div class="hero-actions">
      <a class="button button-primary" href="/docs/">Open the guide <span aria-hidden="true">↗</span></a>
      <a class="button button-secondary" href="/">Back to home</a>
    </div>
  </section>
</SiteLayout>
