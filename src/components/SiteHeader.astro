---
import SiteBrand from './SiteBrand.astro';
const onBlog = Astro.url.pathname.startsWith('/blog/');
---

<header class="site-header">
  <div class="container header-inner">
    <SiteBrand />
    <nav aria-label="Main navigation">
      <a href="/docs/">Documentation</a>
      <a href="/blog/" aria-current={onBlog ? 'page' : undefined}>Blog</a>
      <a class="github-link" href="https://github.com/go42-dev/go42">GitHub <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
